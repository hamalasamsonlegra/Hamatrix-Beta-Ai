const pino = require('pino');
const { SESSION_DIR, OWNER_JID } = require('../config.js');
const { deleteSession } = require('./session.js');
const { getBaileysVersion } = require('./version-cache.js');

const logger = pino({ level: 'silent' });

// Track bot's own sent messages to avoid self-triggering
global.sentMessageIds = new Set();

async function startBot() {
  const {
    makeWASocket,
    useMultiFileAuthState,
    DisconnectReason,
    makeCacheableSignalKeyStore,
    Browsers
  } = await import('ourin-baileys');

  console.time('useMultiFileAuthState');
  const { state, saveCreds } = await useMultiFileAuthState(SESSION_DIR);
  console.timeEnd('useMultiFileAuthState');

  console.time('getBaileysVersion');
  const version = await getBaileysVersion();
  console.timeEnd('getBaileysVersion');

  console.time('makeWASocket');
  const sock = makeWASocket({
    version,
    auth: {
      creds: state.creds,
      keys: makeCacheableSignalKeyStore(state.keys, logger)
    },
    logger,
    browser: Browsers.macOS('Safari'),
    printQRInTerminal: false,
    markOnlineOnConnect: false,
    syncFullHistory: false,
    generateHighQualityLinkPreview: false,
    keepAliveIntervalMs: 25000,
    retryRequestDelayMs: 1500,
    connectTimeoutMs: 120000,
    defaultQueryTimeoutMs: 20000
  });
  console.timeEnd('makeWASocket');

  sock.ev.on('creds.update', saveCreds);

  sock.ev.on('connection.update', (update) => {
    const { connection, lastDisconnect } = update;

    if (connection === 'close') {
      const statusCode = lastDisconnect?.error?.output?.statusCode || 500;
      if (statusCode === DisconnectReason.loggedOut) {
        console.log('Session logged out. Deleting session...');
        deleteSession();
        console.log('Restart the bot to pair again.');
        setTimeout(() => process.exit(0), 2000);
      } else if (statusCode === 515) {
        console.log('Connection restart required (515). Reconnecting in 2s...');
        setTimeout(() => startBot(), 2000);
      } else {
        const delay = 3000 + Math.floor(Math.random() * 6000);
        console.log(`Connection lost (code ${statusCode}). Reconnecting in ${Math.round(delay / 1000)}s...`);
        setTimeout(() => startBot(), delay);
      }
    } else if (connection === 'open') {
      console.log('Bot connected.');
      if (OWNER_JID) {
        sock.sendMessage(OWNER_JID, { text: '✅ Bot is online' }).catch(()=>{});
      }
    }
  });

  return sock;
}

async function sendText(sock, jid, text) {
  return sock.sendMessage(jid, { text });
}

function onMessages(sock, handler) {
  sock.ev.on('messages.upsert', async ({ messages, type }) => {
    console.log('RAW EVENT type:', type, 'count:', messages.length);
    const msg = messages[0];
    if (!msg.message) return;
    if (msg.key.id && global.sentMessageIds.has(msg.key.id)) return;
    console.log('Message keys:', Object.keys(msg.message));
    console.log('RemoteJid:', msg.key.remoteJid);

    let text = '';
    if (msg.message.conversation) text = msg.message.conversation;
    else if (msg.message.extendedTextMessage?.text) text = msg.message.extendedTextMessage.text;
    else if (msg.message.imageMessage?.caption) text = msg.message.imageMessage.caption;
    else if (msg.message.videoMessage?.caption) text = msg.message.videoMessage.caption;

    if (text) {
      console.log('Text extracted:', text);
      await handler({ sock, msg, text, jid: msg.key.remoteJid });
    }
  });
}

module.exports = { startBot, sendText, onMessages };

