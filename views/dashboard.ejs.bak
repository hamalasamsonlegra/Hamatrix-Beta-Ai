<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HAMATRIX Dashboard</title>
  <style>
    body { font-family: Arial, sans-serif; background: #0f0f0f; color: #fff; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
    .card { background: #1a1a1a; border-radius: 16px; padding: 40px; width: 90%; max-width: 600px; box-shadow: 0 0 30px rgba(0,255,255,0.2); }
    h1 { text-align: center; color: #00ffff; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    td { padding: 12px; border-bottom: 1px solid #333; }
    td:first-child { font-weight: bold; color: #aaa; }
    .status { color: #00ff00; font-weight: bold; }
    footer { text-align: center; margin-top: 20px; color: #555; }
    .actions { margin-top: 30px; display: flex; flex-direction: column; gap: 15px; }
    .btn { padding: 12px; text-align: center; border-radius: 8px; text-decoration: none; font-weight: bold; cursor: pointer; }
    .logout { background: #333; color: #fff; }
    .logout:hover { background: #444; }
    .change-form input { width: 70%; padding: 10px; background: #222; border: 1px solid #333; color: #fff; border-radius: 8px; }
    .change-form button { padding: 10px 20px; background: #00cccc; border: none; color: #000; font-weight: bold; border-radius: 8px; cursor: pointer; }
  </style>
</head>
<body>
  <div class="card">
    <h1>🤖 <%= info.botName %></h1>
    <table>
      <tr><td>Status</td><td class="status">🟢 <%= info.status %></td></tr>
      <tr><td>Client</td><td><%= info.user %></td></tr>
      <tr><td>Platform</td><td><%= info.platform %></td></tr>
      <tr><td>Uptime</td><td><%= info.uptime %> seconds</td></tr>
      <tr><td>Commands Loaded</td><td><%= info.commands %></td></tr>
      <tr><td>Memory Used</td><td><%= info.memory %></td></tr>
      <tr><td>Server Time</td><td><%= info.time %></td></tr>
    </table>

    <div class="actions">
      <form class="change-form" method="POST" action="/change-password">
        <input type="password" name="newPassword" placeholder="New password" required>
        <button type="submit">Change Password</button>
      </form>
      <a class="btn logout" href="/logout">Logout</a>
    </div>

    <footer>© HAMATRIX AI</footer>
  </div>
</body>
</html>
