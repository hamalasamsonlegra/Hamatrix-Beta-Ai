<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Command Manager - HAMATRIX</title>
  <style>
    body { font-family: Arial, sans-serif; background: #0f0f0f; color: #fff; padding: 30px; }
    h1 { color: #00ffff; }
    table { width: 100%; border-collapse: collapse; background: #1a1a1a; border-radius: 12px; overflow: hidden; }
    th, td { padding: 12px; border-bottom: 1px solid #333; text-align: left; }
    th { background: #222; }
    .toggle-form { display: inline-block; }
    .btn-toggle { padding: 6px 14px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; }
    .enabled { background: #00cc66; color: #000; }
    .disabled { background: #ff4444; color: #fff; }
    .back-link { color: #00ffff; margin-bottom: 20px; display: inline-block; }
  </style>
</head>
<body>
  <a class="back-link" href="/">← Back to Dashboard</a>
  <h1>🧰 Command Manager</h1>
  <table>
    <tr><th>Command</th><th>Status</th><th>Action</th></tr>
    <% commands.forEach(cmd => { %>
      <tr>
        <td><%= cmd %></td>
        <td>
          <% if (states[cmd]) { %>
            <span style="color:#00cc66">✅ Enabled</span>
          <% } else { %>
            <span style="color:#ff4444">❌ Disabled</span>
          <% } %>
        </td>
        <td>
          <form class="toggle-form" method="POST" action="/toggle-command">
            <input type="hidden" name="command" value="<%= cmd %>">
            <% if (states[cmd]) { %>
              <input type="hidden" name="enabled" value="0">
              <button class="btn-toggle disabled" type="submit">Disable</button>
            <% } else { %>
              <input type="hidden" name="enabled" value="1">
              <button class="btn-toggle enabled" type="submit">Enable</button>
            <% } %>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>
</body>
</html>
